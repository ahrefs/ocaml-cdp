; the generator's logic lives in a (private) library so tests can call it

(library
 (name cdp_gen)
 (modules
  naming
  protocol
  inline_enum
  hoisted_name
  emit
  fetch
  sample
  roundtrip)
 (libraries yojson))

(executable
 (name gen)
 (public_name cdp-gen)
 (package cdp-gen)
 (modules gen)
 (libraries cdp_gen yojson))

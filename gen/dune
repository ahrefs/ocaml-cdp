; the generator's logic lives in a (private) library so tests can call it

; the four hand-written glue modules every generated file needs, embedded at
; build time so `generate` writes them next to its output

(rule
 (target glue.ml)
 (deps
  glue/cdp_json.ml
  glue/cdp_command.ml
  glue/cdp_event.ml
  glue/cdp_envelope.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo
     "(* Generated by dune from lib/: the glue modules written next to the generated files. *)\n")
    (echo "let files =\n  [\n")
    (echo
     "    { Model.Output_file.name = \"cdp_json.ml\"; contents = {glue|")
    (cat glue/cdp_json.ml)
    (echo "|glue} };\n")
    (echo
     "    { Model.Output_file.name = \"cdp_command.ml\"; contents = {glue|")
    (cat glue/cdp_command.ml)
    (echo "|glue} };\n")
    (echo
     "    { Model.Output_file.name = \"cdp_event.ml\"; contents = {glue|")
    (cat glue/cdp_event.ml)
    (echo "|glue} };\n")
    (echo
     "    { Model.Output_file.name = \"cdp_envelope.ml\"; contents = {glue|")
    (cat glue/cdp_envelope.ml)
    (echo "|glue} };\n  ]\n")))))

(library
 (name cdp_gen)
 (modules
  naming
  model
  output_dir
  hoisted_name
  attributes
  dependencies
  glue
  emit
  fetch
  sample
  roundtrip)
 (libraries yojson))

(executable
 (name gen)
 (public_name cdp-gen)
 (package cdp-gen)
 (modules gen)
 (libraries cdp_gen yojson cmdliner))

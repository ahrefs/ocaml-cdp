# cdp-lwt uses libcurl's WebSocket API (Curl.ws_send/ws_meta), which ocurl
# has not released yet (latest release: 0.10.0). These pins make a source
# install (`opam install .`) work out of the box. The official opam
# repository rejects pin-depends, so cdp-lwt cannot be published there until
# ocurl cuts a release — cdp and cdp-gen are unaffected.
pin-depends: [
  [ "curl.0.10.0" "git+https://github.com/ygrek/ocurl.git#dc00dcb3ec5c1b55a28448a2f301fa1ce6af3019" ]
  [ "curl_lwt.0.10.0" "git+https://github.com/ygrek/ocurl.git#dc00dcb3ec5c1b55a28448a2f301fa1ce6af3019" ]
]

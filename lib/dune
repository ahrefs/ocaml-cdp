; every .ml here is written by `make generate`; the glue sources are gen/glue/

(library
 (name cdp)
 (public_name cdp)
 ; wrapped false on purpose: every module is Cdp_-prefixed, the cdp.ml index
 ; exposes them as Cdp.Network etc., and a future melange twin must share
 ; these sources under stable module names (the jsonkit pattern)
 (wrapped false)
 (libraries jsonkit yojson)
 (preprocess
  (pps jsonkit.ppx ppx_deriving.show ppx_deriving.eq ppx_deriving.make))
 ; generated code trips unused warnings by construction, and its own
 ; derived functions reference deprecated/experimental items (alerts)
 (flags
  (:standard -w -a -alert -all)))

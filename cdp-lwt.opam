# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Lwt transport for the cdp library over libcurl WebSockets"
description:
  "Lwt client for the Chrome DevTools Protocol: launches or attaches to a Chrome and drives it over libcurl WebSockets, using the typed commands and events from the cdp package."
maintainer: [
  "Vitalii Shapoval <vytalych@gmail.com>" "Ahrefs <github@ahrefs.com>"
]
authors: [
  "Vitalii Shapoval <vytalych@gmail.com>" "Ahrefs <github@ahrefs.com>"
]
license: "MIT AND BSD-3-Clause"
tags: ["org:ahrefs" "chrome" "devtools" "cdp" "lwt"]
homepage: "https://github.com/ahrefs/ocaml-cdp"
bug-reports: "https://github.com/ahrefs/ocaml-cdp/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "4.14"}
  "cdp" {= version}
  "curl"
  "curl_lwt"
  "lwt" {>= "5.10"}
  "lwt_ppx" {>= "5.9"}
  "base64" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ahrefs/ocaml-cdp.git"
x-maintenance-intent: ["(latest)"]
# cdp-lwt uses libcurl's WebSocket API (Curl.ws_send/ws_meta), which ocurl
# has not released yet (latest release: 0.10.0). These pins make a source
# install (`opam install .`) work out of the box. The official opam
# repository rejects pin-depends, so cdp-lwt cannot be published there until
# ocurl cuts a release — cdp and cdp-gen are unaffected.
pin-depends: [
  [ "curl.0.10.0" "git+https://github.com/ygrek/ocurl.git#dc00dcb3ec5c1b55a28448a2f301fa1ce6af3019" ]
  [ "curl_lwt.0.10.0" "git+https://github.com/ygrek/ocurl.git#dc00dcb3ec5c1b55a28448a2f301fa1ce6af3019" ]
]

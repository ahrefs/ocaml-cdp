The roundtrip subcommand writes a standalone test file with schema-driven
encode/decode checks for every generated type.

  $ cat > browser.json << 'EOF'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"Mood","type":"string","enum":["happy","sad"]},
  >   {"id":"Point","type":"object","properties":[
  >     {"name":"x","type":"integer"},
  >     {"name":"y","type":"number","optional":true}
  >   ]}
  > ]}]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ cdp-gen roundtrip browser.json js.json roundtrip_out.ml Demo
  generated roundtrip_out.ml: 2 roundtrip checks, 0 skipped
  $ cat roundtrip_out.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  (* Roundtrip tests over every generated type: decode a sample synthesized
     from the protocol schema, encode it back, decode again, and compare.
     The encoded JSON must also equal the input, keys sorted. *)
  
  let failures = ref 0
  
  let fail name what =
    incr failures;
    Printf.printf "FAIL %s: %s\n" name what
  
  let rec sort_keys (json : Yojson.Basic.t) : Yojson.Basic.t =
    match json with
    | `Assoc fields ->
      `Assoc
        (fields
        |> List.sort (fun (left, _) (right, _) -> String.compare left right)
        |> List.map (fun (key, value) -> key, sort_keys value))
    | `List items -> `List (List.map sort_keys items)
    | scalar -> scalar
  
  let check name of_json to_json equal raw =
    let json = Yojson.Basic.from_string raw in
    let decoded = of_json json in
    let encoded = to_json decoded in
    (match Yojson.Basic.equal (sort_keys encoded) (sort_keys json) with
    | true -> ()
    | false -> fail name ("encoded JSON differs from the input: " ^ Yojson.Basic.to_string encoded));
    let redecoded = of_json encoded in
    match equal decoded redecoded with
    | true -> ()
    | false -> fail name "value changed after an encode/decode roundtrip"
  
  let () = check "Demo.Mood" Cdp.Demo.mood_of_json Cdp.Demo.mood_to_json Cdp.Demo.equal_mood "\"happy\""
  let () = check "Demo.Point" Cdp.Demo.point_of_json Cdp.Demo.point_to_json Cdp.Demo.equal_point "{\"x\":7,\"y\":1.5}"
  
  let () =
    match !failures with
    | 0 -> print_endline "all roundtrip tests passed"
    | count -> failwith (Printf.sprintf "%d roundtrip failures" count)

A type with a required array of itself gets an empty list as its sample, so
the recursion ends and the type is still checked.

  $ cat > browser.json << 'EOF2'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"Tree","type":"object","properties":[
  >     {"name":"children","type":"array","items":{"$ref":"Tree"}}
  >   ]}
  > ]}]}
  > EOF2
  $ cdp-gen roundtrip browser.json js.json tree_out.ml Demo
  generated tree_out.ml: 1 roundtrip checks, 0 skipped
  $ grep "let () = check" tree_out.ml
  let () = check "Demo.Tree" Cdp.Demo.tree_of_json Cdp.Demo.tree_to_json Cdp.Demo.equal_tree "{\"children\":[]}"

A type whose required non-array field cycles back to itself has no finite
sample; it is skipped loudly instead of looping forever, and no check is emitted.

  $ cat > browser.json << 'EOF3'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"Chain","type":"object","properties":[
  >     {"name":"next","$ref":"Chain"}
  >   ]}
  > ]}]}
  > EOF3
  $ cdp-gen roundtrip browser.json js.json chain_out.ml Demo
  generated chain_out.ml: 0 roundtrip checks, 1 skipped
  skipped Demo.Chain: cdp-gen: required-field cycle through Demo.Chain
  $ grep "let () = check" chain_out.ml
  [1]

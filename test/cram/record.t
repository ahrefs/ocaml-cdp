A record: required + optional fields, camelCase keys, keyword rename (type -> type_).
Optionals become option; on encode None fields are omitted.

  $ cat > browser.json << 'EOF'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"Item","type":"object","properties":[
  >     {"name":"itemId","type":"string"},
  >     {"name":"type","type":"string"},
  >     {"name":"byteSize","type":"integer","optional":true},
  >     {"name":"score","type":"number","optional":true}
  >   ]}
  > ]}]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ mkdir out && cdp-gen generate browser.json js.json out Demo
  generated cdp_base.ml: 0 sealed alias modules
  generated cdp_demo(_types).ml: 1 types, 0 commands, 0 events
  generated cdp.ml index (1 domains, protocol unknown)
  $ cat out/cdp_demo_types.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  open Jsonkit.Primitives
  
  
  type item = {
    item_id : string [@key "itemId"];
    type_ : string [@key "type"];
    byte_size : int option [@key "byteSize"] [@option] [@json.drop_default];
    score : float option [@key "score"] [@option] [@json.drop_default];
  }
  [@@allow_extra_fields]
  [@@deriving json, show, eq]

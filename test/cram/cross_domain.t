Cross-domain references: a named type ref goes through Other_types;
a primitive-alias ref goes through Base (so no module cycle is possible).
Deprecated and experimental items get annotations.

  $ cat > browser.json << 'EOF'
  > {"domains":[
  >   {"domain":"Alpha","types":[
  >     {"id":"AlphaId","type":"string"},
  >     {"id":"Color","type":"string","enum":["red","green"],"deprecated":true}
  >   ]},
  >   {"domain":"Beta","types":[
  >     {"id":"Usage","type":"object","experimental":true,"properties":[
  >       {"name":"id","$ref":"Alpha.AlphaId"},
  >       {"name":"color","$ref":"Alpha.Color","optional":true}
  >     ]}
  >   ]}
  > ]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ mkdir out && cdp-gen generate browser.json js.json out Alpha,Beta
  generated cdp_base.ml: 1 sealed alias modules
  generated cdp_alpha(_types).ml: 2 types, 0 commands, 0 events
  generated cdp_beta(_types).ml: 1 types, 0 commands, 0 events
  generated cdp.ml index (2 domains, protocol unknown)
  $ cat out/cdp_beta_types.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  open Melange_json.Primitives
  
  
  type usage = {
    id : Cdp_base.Alpha.Alpha_id.t [@key "id"];
    color : Cdp_alpha_types.color option [@key "color"] [@option] [@json.drop_default];
  }
  [@@allow_extra_fields]
  [@@alert experimental "experimental in CDP, may change with Chrome"]
  [@@deriving json, show, eq]

The index module:

  $ cat out/cdp.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  (* Index: users write Cdp.Network, Cdp.Page, ... *)
  
  module Json = Cdp_json
  module Command = Cdp_command
  module Event = Cdp_event
  module Envelope = Cdp_envelope
  module Base = Cdp_base
  module Alpha = Cdp_alpha
  module Alpha_types = Cdp_alpha_types
  module Beta = Cdp_beta
  module Beta_types = Cdp_beta_types

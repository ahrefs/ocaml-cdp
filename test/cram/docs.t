Protocol descriptions become doc comments, so an editor shows the Chrome text
on every domain, type, field, command and event. odoc markup characters are
escaped.

  $ cat > browser.json << 'EOF'
  > {"domains":[{"domain":"Demo","description":"A demo domain.","types":[
  >   {"id":"Point","type":"object","description":"A point on the {page}.","properties":[
  >     {"name":"x","type":"integer","description":"Horizontal, in [px]."},
  >     {"name":"y","type":"integer"}
  >   ]}
  > ],"commands":[
  >   {"name":"move","description":"Moves @ once.","parameters":[
  >     {"name":"to","$ref":"Point","description":"Where to go."}
  >   ]}
  > ]}]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ mkdir out && cdp-gen generate browser.json js.json out Demo > /dev/null
  $ head -4 out/cdp_demo_types.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  [@@@ocaml.doc "A demo domain."]
  


  $ grep -B1 -A6 'type point' out/cdp_demo_types.ml
  
  type point = {
    x : int [@key "x"] [@ocaml.doc "Horizontal, in \\[px\\]."];
    y : int [@key "y"];
  }
  [@@allow_extra_fields]
  [@@ocaml.doc "A point on the \\{page\\}."]
  [@@deriving json, show, eq]
  $ grep 'ocaml.doc' out/cdp_demo.ml
  [@@@ocaml.doc "A demo domain."]
    to_ : point [@key "to"] [@ocaml.doc "Where to go."];
  [@@ocaml.doc "Moves \\@ once."]
  $ grep -A1 'module Demo = ' out/cdp.ml
  module Demo = Cdp_demo
  [@@ocaml.doc "A demo domain."]

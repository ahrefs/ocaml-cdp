Primitive aliases become sealed modules in base.ml, re-exported by the domain.
A string alias gets of_string/to_string; a number alias gets of_float/to_float.

  $ cat > browser.json << 'EOF'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"ItemId","type":"string"},
  >   {"id":"Timestamp","type":"number"},
  >   {"id":"Ref","type":"object","properties":[
  >     {"name":"id","$ref":"ItemId"},
  >     {"name":"at","$ref":"Timestamp","optional":true}
  >   ]}
  > ]}]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ mkdir out && cdp-gen generate browser.json js.json out Demo
  generated cdp_base.ml: 2 sealed alias modules
  generated cdp_demo(_types).ml: 3 types, 0 commands, 0 events
  generated cdp.ml index (1 domains, protocol unknown)
  $ cat out/cdp_base.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  (* Sealed modules for every primitive alias type. This file depends on
     nothing, so alias references can never create a module cycle. *)
  
  module Demo = struct
  module Item_id : sig
    type t
    val of_string : string -> t
    val to_string : t -> string
    val equal : t -> t -> bool
    val compare : t -> t -> int
    val pp : Format.formatter -> t -> unit
    val show : t -> string
    val of_json : Melange_json.t -> t
    val to_json : t -> Melange_json.t
  end = struct
    type t = string
    let of_string x = x
    let to_string x = x
    let equal = String.equal
    let compare = String.compare
    let show (x : t) = Printf.sprintf "%S" x
    let pp fmt x = Format.pp_print_string fmt (show x)
    let of_json = Melange_json.Primitives.string_of_json
    let to_json = Melange_json.Primitives.string_to_json
  end
  
  module Timestamp : sig
    type t
    val of_float : float -> t
    val to_float : t -> float
    val equal : t -> t -> bool
    val compare : t -> t -> int
    val pp : Format.formatter -> t -> unit
    val show : t -> string
    val of_json : Melange_json.t -> t
    val to_json : t -> Melange_json.t
  end = struct
    type t = float
    let of_float x = x
    let to_float x = x
    let equal = Float.equal
    let compare = Float.compare
    let show (x : t) = string_of_float x
    let pp fmt x = Format.pp_print_string fmt (show x)
    let of_json = Melange_json.Primitives.float_of_json
    let to_json = Melange_json.Primitives.float_to_json
  end
  
  end
  
  $ cat out/cdp_demo_types.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  open Melange_json.Primitives
  
  module Item_id = Cdp_base.Demo.Item_id
  module Timestamp = Cdp_base.Demo.Timestamp
  
  type ref = {
    id : Cdp_base.Demo.Item_id.t [@key "id"];
    at : Cdp_base.Demo.Timestamp.t option [@key "at"] [@option] [@json.drop_default];
  }
  [@@allow_extra_fields]
  [@@deriving json, show, eq]

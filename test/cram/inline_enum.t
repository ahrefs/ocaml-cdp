Inline field enums are hoisted to named variant types.
In a named type: parent_field naming. In a command submodule: field name only.

  $ cat > browser.json << 'EOF'
  > {"domains":[{"domain":"Demo","types":[
  >   {"id":"Widget","type":"object","properties":[
  >     {"name":"state","type":"string","enum":["on","off"]}
  >   ]}
  > ],"commands":[
  >   {"name":"setMode","parameters":[
  >     {"name":"mode","type":"string","enum":["fast","slow"]}
  >   ]}
  > ]}]}
  > EOF
  $ echo '{"domains":[]}' > js.json
  $ mkdir out && cdp-gen generate browser.json js.json out Demo
  generated cdp_base.ml: 0 sealed alias modules
  generated cdp_demo(_types).ml: 1 types, 1 commands, 0 events
  generated cdp.ml index (1 domains, protocol unknown)
  $ cat out/cdp_demo_types.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  open Melange_json.Primitives
  
  
  type widget_state =
    | On [@json.name "on"]
    | Off [@json.name "off"]
    | Other of Cdp_json.unknown [@json.catch_all]
  [@@compact_variants]
  
  and widget = {
    state : widget_state [@key "state"];
  }
  [@@allow_extra_fields]
  [@@deriving json, show, eq]
  $ cat out/cdp_demo.ml
  (* Generated by cdp-gen from Chrome DevTools Protocol unknown. DO NOT EDIT. *)
  
  include Cdp_demo_types
  open Melange_json.Primitives
  
  module Set_mode = struct
  let name = "Demo.setMode"
  
  type mode =
    | Fast [@json.name "fast"]
    | Slow [@json.name "slow"]
    | Other of Cdp_json.unknown [@json.catch_all]
  [@@compact_variants]
  [@@deriving json, show, eq]
  
  type params = {
    mode : mode [@key "mode"];
  }
  [@@allow_extra_fields]
  [@@deriving json, show, eq, make]
  
  type result = unit [@@deriving show, eq]
  
  let result_of_json (_ignored_payload : Cdp_json.t) : result = ()
  
  let command params : result Cdp_command.t =
    { Cdp_command.name; params = Some (params_to_json params); parse = result_of_json }
  
  end
  
